<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SquirrelBox.Messaging.Pigeon</PackageId>
    <Title>SquirrelBox Pigeon Messaging Adapter</Title>
    <PackageType>Dependency</PackageType>
    <Description>Pigeon consume interceptor adapter for SquirrelBox messaging idempotency.</Description>
    <PackageTags>$(PackageTags);messaging;pigeon;interceptor</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pigeon.Messaging" Version="2.8.0" />
    <ProjectReference Include="..\SquirrelBox.Messaging\SquirrelBox.Messaging.csproj" />
    <ProjectReference Include="..\SquirrelBox\SquirrelBox.csproj" />
  </ItemGroup>

</Project>
