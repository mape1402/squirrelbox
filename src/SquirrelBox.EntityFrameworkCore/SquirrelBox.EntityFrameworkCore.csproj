<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SquirrelBox.EntityFrameworkCore</PackageId>
    <Title>SquirrelBox Entity Framework Core Provider</Title>
    <PackageType>Dependency</PackageType>
    <Description>Entity Framework Core storage provider for SquirrelBox durable inbox and outbox records.</Description>
    <PackageTags>$(PackageTags);entity-framework-core;ef-core;persistence</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.20" />
    <ProjectReference Include="..\SquirrelBox\SquirrelBox.csproj" />
  </ItemGroup>

</Project>
